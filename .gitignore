# ==============================================================================
# HabitSeen - Comprehensive Git Ignore
# ==============================================================================

# 1. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js

# 2. Build Outputs & Bundles
dist/
dist-ssr/
dev-dist/

# 3. Environment & Secret Variables (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# 4. Android Build Artifacts & Local SDK Configs
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml

# APKs, Bundles, Keystores & Signing Keys
*.apk
*.aab
*.zip
bundle.zip
*.jks
*.keystore
*.dex
*.class

# Google Services Credentials (Uncomment if public repo)
# android/app/google-services.json

# 5. IDE, Editor & OS Temporary Files
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Logs & Debug Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. PWA Service Worker Dev Artifacts
sw.js
workbox-*.js
